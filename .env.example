# 7Gather - Environment Variables
# Copy this file to .env and fill in the values before running docker compose up.

# =============================================================================
# LiveKit Configuration
# =============================================================================

# URL where the LiveKit server is accessible (used by the Colyseus server and client)
LIVEKIT_URL=ws://localhost:7880

# API credentials for LiveKit token generation
# Generate strong random values for production use
LIVEKIT_API_KEY=devkey7gather
LIVEKIT_API_SECRET=this-is-a-dev-secret-at-least-32chars

# =============================================================================
# Optional: TURN domain for production deployments
# =============================================================================

# Domain used for TURN server TLS (leave empty for local development)
LIVEKIT_TURN_DOMAIN=

# =============================================================================
# Nginx / Domain Configuration (for production deployments)
# =============================================================================

# Primary domain for the platform (used by traditional nginx.conf template)
# For Nginx Proxy Manager, configure domains via the UI on port 81
DOMAIN=gather.example.com

# SSL certificate paths (for traditional nginx deployments only)
# Nginx Proxy Manager handles SSL certificates automatically via its UI
SSL_CERT_PATH=/etc/letsencrypt/live/gather.example.com/fullchain.pem
SSL_KEY_PATH=/etc/letsencrypt/live/gather.example.com/privkey.pem

# Email for Let's Encrypt certificate notifications
CERTBOT_EMAIL=admin@example.com
